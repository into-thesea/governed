# ============================================================
# LLM 配置（OpenAI 兼容接口）
# ============================================================
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 可选：其他 OpenAI 兼容模型
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ============================================================
# Embedding —— 长期记忆的向量化
# ============================================================
# 提供方：local（本地 sentence-transformers 模型，无外部服务与凭据）
#         | openai（任何 OpenAI 兼容的 embeddings 端点）
# 写入与检索必须用**同一个模型**：换模型后旧向量与新查询不在同一空间，相似度
# 没有意义，需要重建记忆库（维度不符会在启动探活时被拦下）。
EMBEDDING_PROVIDER=local

# --- provider=local ---
# 模型：接受 HF 模型名、本地模型目录，或 HF 缓存目录
# （models--<org>--<name> 形式会自动解开到 snapshots/<rev>/）。
# 需要先装运行时：pip install sentence-transformers
EMBEDDING_MODEL=models--BAAI--bge-base-zh-v1.5
EMBEDDING_DEVICE=cpu
# HF 缓存根目录（含 models--* 的目录）；模型目录已直接给出时可留空
EMBEDDING_CACHE_DIR=
# 检索查询的前缀。BGE 中文系列按官方用法需要指令前缀；留空则按模型名自动判定
EMBEDDING_QUERY_PREFIX=

# --- provider=openai ---
# base_url 与 key 必须配套：拿 DeepSeek 的 key 打 OpenAI 的端点只会得到 401，
# 而 DeepSeek 本身不提供 embeddings 接口。示例（DashScope 通义）：
# EMBEDDING_API_KEY=your_embedding_key_here
# EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# EMBEDDING_MODEL=text-embedding-v4

# 向量维度（仅供参考，实际以提供方返回为准）
EMBEDDING_DIM=768

# ============================================================
# 服务地址一律写 IPv4 字面量 127.0.0.1，不要写 localhost：
# ============================================================

# ============================================================
# Milvus —— 长期向量记忆（可选后端；默认用 pgvector）
# ============================================================
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_COLLECTION_PREFIX=governed_
MILVUS_INDEX_TYPE=HNSW
MILVUS_METRIC_TYPE=COSINE

# ============================================================
# 长期记忆 —— 跨会话经验沉淀，向量后端可切换
# ============================================================
# 后端：pgvector（默认）| milvus | local
# 首选不可用时**自动降级为 local**（进程内实现，真实余弦相似度，数据落 MEMORY_DIR）。
# 降级是显式的：实际生效的后端会写进启动日志，也能从 /stats 类接口看到。
MEMORY_VECTOR_BACKEND=pgvector

# pgvector 连接串。注意它需要**写权限**（要建表与索引），与只读的数据源账号不同。
# 留空即判定后端不可用并降级。生产用环境变量注入，不要写进版本库。
# 配套的 compose 镜像已是 pgvector/pgvector:pg16，扩展由 infra/db/postgres-init.sql 建好。
MEMORY_PG_DSN=postgresql://harness_admin:harness_admin_pw@127.0.0.1:55432/harness
# 索引类型：hnsw（默认，查询快）| ivfflat | none
MEMORY_PG_INDEX=hnsw

# 检索：返回条数、相似度阈值（低于此值不返回）、查询短于多少字符就不检索
# （避免"分析""报告"这类泛词命中一堆无关记忆）
MEMORY_LONG_TERM_TOP_K=5
# 阈值**取决于 Embedding 模型**，换模型要重新标定。实测 bge-base-zh-v1.5：
# 相关召回 0.44~0.53，无关 0.24~0.34 → 取两者之间。宁松勿紧：多注入一条无关
# 记忆只是噪声，漏掉相关记忆则等于这层能力不存在。
MEMORY_LONG_TERM_SIMILARITY_THRESHOLD=0.38
MEMORY_LONG_TERM_MIN_QUERY_CHARS=8

# 容量上界：单条记忆的内容上限（超出截断）、每个主体保留的条数上限（超出淘汰最旧的）。
# 没有容量上界的向量库在跑得久的部署里会无限增长。
MEMORY_LONG_TERM_MAX_CONTENT_CHARS=2000
MEMORY_LONG_TERM_MAX_ITEMS=500

# ============================================================
# Kafka —— 审计日志、链路追踪、事件总线
# ============================================================
KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
KAFKA_AUDIT_TOPIC=governed_audit
KAFKA_TRACE_TOPIC=governed_trace
KAFKA_EVENT_TOPIC=governed_events
KAFKA_CONSUMER_GROUP=governed_consumer
KAFKA_ENABLE_AUDIT_PRODUCE=true
KAFKA_ENABLE_TRACE_PRODUCE=true

# spool（投递缓冲）文件数上限。Kafka 长期不可达时 spool 只进不出，没上限会写满
# 磁盘。超出丢最旧的并告警 —— spool 是缓冲不是存储，被丢的只是没上送，
# 审计的本地留档（audit.jsonl）不受影响。
KAFKA_SPOOL_MAX_FILES=5000

# ============================================================
# MinIO —— VFS 虚拟文件系统后端（默认关闭，VFS 落本地磁盘）
# ============================================================
# 默认 false。打开前先确认这个 endpoint 指向的是**你自己起的** MinIO：
# 端口撞上别的项目（比如 Milvus 自带的 MinIO）时连接会成功、bucket 也建得出来，
# VFS 数据就静默写进了别人的对象存储。
MINIO_ENABLED=false
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=governed
MINIO_SECURE=false

# VFS 本地回退目录（MinIO 不可用时使用）
VFS_LOCAL_ROOT=data/vfs

# ============================================================
# FastAPI 服务层
# ============================================================
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=1
SERVER_RELOAD=false
SERVER_CORS_ORIGINS=*
SERVER_API_PREFIX=/api/v1

# 这个部署有没有人审：http（有人审）| none（明确无人值守）；**不配置则视为没回答过**
# 挂有需审批工具（requires_approval=True）时**必须**回答，否则服务**启动即失败**；
# 配成 none 却有需审批工具，属于自相矛盾，同样启动失败。测试环境默认已置 http。
SERVER_APPROVAL_CHANNEL=http
# 有通道但一直没人应怎么办：auto_reject（超时自动驳回并推进）| block（一直等，会打 WARNING）
SERVER_APPROVAL_UNATTENDED=auto_reject
# auto_reject 的清扫间隔（秒）
SERVER_APPROVAL_SWEEP_SECONDS=30
# 执行前计划审批：计划生成后停下来等人批准，再开始执行（默认关 = 零回归）
# **打开需要有人审**：SERVER_APPROVAL_CHANNEL 不是 http 时，开了它装配即失败
SERVER_PLAN_APPROVAL=false

# 审批的风险阈值（部署方旋钮；领域包只声明工具的"多危险"）
# low | medium | high | critical，写错则启动失败
# 高过这条线 → 问人
SERVER_APPROVAL_THRESHOLD=medium
# 达到这条线 → 直接拒，连问都不问。调低它（如 high）会让更多档位被直接拒绝
SERVER_APPROVAL_DENY_THRESHOLD=critical

# ============================================================
# 安全沙箱（Docker 容器隔离）
# ============================================================
# OpenSandbox 控制面（服务端见 infra/opensandbox-server/，与之配置保持一致）
SANDBOX_ENABLED=true
SANDBOX_SERVER_URL=http://127.0.0.1:8080
# 无内置默认值：必填，且与服务端启动时的 OPENSANDBOX_SERVER_API_KEY 完全一致；
# 留空时 code_executor 一律 fail closed（沙箱不可用），不会在宿主上退化执行
SANDBOX_API_KEY=

# 沙箱容器（自建镜像：infra/Dockerfile.sandbox）
SANDBOX_IMAGE=governed-sandbox:latest
SANDBOX_WORKDIR=/home/sandbox
SANDBOX_CPU_LIMIT=1.0
SANDBOX_MEMORY_LIMIT=512m
SANDBOX_READY_TIMEOUT_SECONDS=180

# 同时运行的沙箱数上限。每个沙箱要起一个容器、按上面的 CPU/内存占资源，
# 不限并发时一批并行子任务能瞬间把宿主压垮。
#   0  = 按 CPU 核数 / SANDBOX_CPU_LIMIT 推导（默认，跟着机器走）
#   >0 = 显式指定
#   <0 = 不限制（不建议）
SANDBOX_MAX_CONCURRENCY=0

# ============================================================
# 工具熔断（按工具名独立的三态熔断器）
# ============================================================
# 熔断与限流是两件事：限流挡"调用太密"，熔断挡"调了也没用"。
# 下游持续故障时，每次调用都等一次超时才失败，而 LLM 看到失败还会重试 ——
# 熔断让"已经知道坏了"这件事立刻返回。
#
# 只在工具**抛异常**时计数。业务上返回失败（文件不存在、SQL 被权限拒绝）说明
# 下游是活的，不触发熔断。
CIRCUIT_ENABLED=true
# 连续失败多少次后熔断。策略阈值：太小会因偶发抖动误熔断，太大则响应太慢。
CIRCUIT_FAILURE_THRESHOLD=5
# 熔断后隔离多久再放试探。默认一个完整限流窗口（60 秒），给下游同等时间恢复。
CIRCUIT_COOLDOWN_SECONDS=60
# 半开状态允许几个试探同时在飞（1 = 刚恢复不该立刻被打满）
CIRCUIT_HALF_OPEN_TRIALS=1

# 工具结果缓存
#
# 只对**显式声明** cacheable 的只读确定性工具生效（当前是数据体检与 EDA）。
# 键由「工具名 + 参数 + 输入文件身份（大小 + mtime）」构成，所以**没有 TTL 可调** ——
# 文件没变就命中，变了立即失效。命中仍走权限、校验、熔断、限流与审计。
CACHE_ENABLED=true
# 条目上限（有界 LRU，超出淘汰最久未用）。策略量：每条目只存文本与结构化产物，
# 大结果按设计已沉淀到 VFS。
CACHE_MAX_ENTRIES=128

# 单次执行（信任边界，勿放宽）
SANDBOX_TIMEOUT_SECONDS=30
SANDBOX_MAX_TIMEOUT_SECONDS=300
SANDBOX_ARTIFACT_MAX_BYTES=33554432

# false = 下发 NetworkPolicy(default_action="deny")，容器无出网
SANDBOX_NETWORK_ENABLED=false

# ============================================================
# 链路追踪
# ============================================================
# 埋点覆盖：请求 → 规划 → 委派 → LLM 决策 / 工具调用 → 质量门 → 汇总。
# 同一 trace_id 内的 Span 会自动串成调用树。
TRACE_ENABLED=true
# 采样按 **trace** 判定（不是按 span）——按 span 采会把调用树采残，反而更难用。
# 生产高流量时可下调，比如 0.1。
TRACE_SAMPLE_RATE=1.0
TRACE_SERVICE_NAME=governed
TRACE_ENVIRONMENT=development

# Span 出口：local（落 JSONL，单机默认）| kafka（上送，供链路可视化消费）| none
TRACE_SINK=local
# local 出口：落盘目录、单文件上限、保留份数（按大小轮转，只留最近几份）。
# 轮转是必须的 —— 没有上限的追踪日志迟早把磁盘写满。
TRACE_LOCAL_DIR=data/trace
TRACE_MAX_FILE_BYTES=33554432
TRACE_BACKUP_COUNT=3
# 单条 trace 在内存里保留的 Span 上限：超出后仍会写出口，只是不再留内存供
# 调用树查询（否则长任务的内存占用无上限）
TRACE_MAX_SPANS_PER_TRACE=2000
# 单个 Span 的标签数上限
TRACE_MAX_TAGS_PER_SPAN=50

# ============================================================
# 事件落盘（控制台的历史回放）
# ============================================================
# 一个任务一个 append-only JSONL（<dir>/<thread_id>.jsonl）。关掉则控制台只能看
# 正在跑的任务 —— 任务一终态，内存历史随总线解绑清除，跑完就什么都没有了。
EVENT_ENABLED=true
EVENT_DIR=data/events
# 保留天数：超过的任务文件在**服务启动时**清理一次；<=0 表示不清理
EVENT_RETENTION_DAYS=30
# 单个任务文件的封顶。**封顶不是轮转**：超过后不再写，以保证"回放 = 读一个文件"
EVENT_MAX_FILE_BYTES=33554432

# ============================================================
# 运行配置
# ============================================================
LOG_LEVEL=INFO
LOG_FORMAT=json
CHECKPOINT_DIR=data/checkpoints
AUDIT_DIR=data/audit
MEMORY_DIR=data/memory
MAX_WORKERS=10
DEFAULT_MAX_STEPS=20
DEFAULT_TIMEOUT_SECONDS=300

# 单个调度批次里并发执行的子任务数上限。
#   0  = 按就绪集大小，不额外限制（默认）
#   >0 = 显式指定，超出的部分下一批再跑（不会丢任务）
# 计划里 depends_on 为空的多条任务本就没有先后关系，会并发执行；有依赖的仍串行。
# 并发度天然受"就绪集大小"约束，而真正稀缺的资源（沙箱）另由
# SANDBOX_MAX_CONCURRENCY 限流，所以默认不额外设限。
MAX_PARALLEL_SUBTASKS=0

# 工具调用范式：react（过程可见/模型无关，教学调试）| native（原生 Function Calling，生产）
AGENT_TOOL_MODE=react

# ============================================================
# 上下文管理（ContextManager 的预算与沉淀策略）
# 调大 SINK_THRESHOLD_CHARS → 更多原文留在提示里（省 VFS 但费 token）
# 调小 MAX_HISTORY_CHARS   → 更早的中间过程被折叠（省 token 但可能丢脉络）
# 两者此消彼长，改前建议先看实测数据
# ============================================================
CONTEXT_SINK_THRESHOLD_CHARS=500
CONTEXT_OBSERVATION_HEAD_CHARS=200
CONTEXT_OBSERVATION_CHAR_LIMIT=1200
CONTEXT_KEEP_RECENT_MESSAGES=8
CONTEXT_MAX_HISTORY_CHARS=6000
CONTEXT_SUMMARY_HEAD_CHARS=120

# ============================================================
# 图状态检查点（审批中断的持久化）
# backend=sqlite（默认）→ 状态落盘，服务重启后仍能继续审批
# backend=memory       → 进程内，重启即丢（仅测试/短命令流程用）
# 未知取值会显式报错，不会静默回退
# ============================================================
CHECKPOINT_BACKEND=sqlite
CHECKPOINT_SQLITE_PATH=data/checkpoints.sqlite
# backend=postgres 时必填（多副本共享检查点，配合 Redis 限流构成共享状态层）
# CHECKPOINT_POSTGRES_DSN=postgresql://user:pass@host:5432/db

# ============================================================
# 工具调用限流（滑动窗口）
# backend=process（默认）→ 进程内滑动窗口，单机够用；多副本时各副本各算各的
# backend=redis         → 共享 Redis（zset+Lua 原子滑动窗口），多副本时限流配额全局一致
# 未知取值会显式报错，不会静默回退
# ============================================================
RATE_LIMIT_BACKEND=process
# backend=redis 时必填
# RATE_LIMIT_REDIS_URL=redis://host:6379/0

# ============================================================
# 多数据源（C5：SQLAlchemy 统一连接层）
# 命名源，值为 JSON。驱动名务必注意：
#   PostgreSQL 用 postgresql+psycopg://（v3；写 psycopg2 会 ModuleNotFoundError）
#   MySQL      用 mysql+pymysql://
# 本地开发可先起库：docker compose -f infra/docker-compose.yml up -d postgres mysql
# 只读账号 harness_ro（两个库都只授了 SELECT，写入会失败 —— 这是有意的）
# ============================================================
DATASOURCE_SOURCES={"pg_dev":"postgresql+psycopg://harness_ro:harness_ro_pw@127.0.0.1:55432/harness","mysql_dev":"mysql+pymysql://harness_ro:harness_ro_pw@127.0.0.1:53306/harness"}
DATASOURCE_DEFAULT=

# ============================================================
# 服务端鉴权（对内网/对外提供服务时必须配置）
# 令牌 → 身份（JSON 对象）：角色**只能**来自这里，请求体里的 role 一律无效。
# AUTH_ENABLED=true 而未配置令牌 → 服务端**直接启动失败**（避免"以为开了、实际没开"）
# 本地开发可设 AUTH_ENABLED=false：只有一个身份（admin）并打 WARNING。
# 令牌请用长随机串；审计只记角色与名字，不记令牌原文。
# ============================================================
AUTH_ENABLED=true
AUTH_TOKENS={"change-me-long-random-token":{"role":"analyst","name":"分析员"},"change-me-another-long-token":{"role":"admin","name":"管理员"}}
AUTH_APPROVER_ROLES=admin
